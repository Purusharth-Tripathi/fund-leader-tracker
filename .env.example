# Holdings/data providers
# Preferred holdings provider for ETF reviews

# Fallback market/fund data provider
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Database Configuration
DATABASE_PATH=data/fund_leaders.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/fund_tracker.log

# API/network options
# Leave SSL verification enabled unless you have a known corporate MITM/proxy requirement.
API_VERIFY_SSL=true

# Optional email alerts
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com
